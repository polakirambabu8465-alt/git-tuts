pipeline {
    agent any

    tools {
        maven 'M3'
    }

    stages {

        stage('Verify Maven') {
            steps {
                bat 'mvn -v'
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }

        stage('Package') {
            steps {
                bat 'mvn package'
            }
        }
    }
}
